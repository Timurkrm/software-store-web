# Local Docker Compose example. Do not commit a real .env file with secrets.
POSTGRES_DB=software_store
POSTGRES_USER=software_user
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_PORT=5432
APP_PORT=8080

# Use a random value of at least 32 characters outside local development.
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SPRING_PROFILES_ACTIVE=dev

# Optional: an administrator is seeded only when both values are present in dev.
APP_SEED_ADMIN_EMAIL=admin@example.test
APP_SEED_ADMIN_PASSWORD=replace-with-admin-password
