IPaymentService <|.. PaymentMediator
ILicenseService <|.. LicenseMediator
UserMediator --> UserRepository
ProductMediator --> ProductRepository
CategoryMediator --> CategoryRepository
CartMediator --> CartRepository
CheckoutFacade --> OrderRepository
PaymentMediator --> PaymentRepository
LicenseMediator --> LicenseRepository
UserRepository --> User
ProductRepository --> SoftwareProduct
CategoryRepository --> Category
CartRepository --> Cart
OrderRepository --> Order
