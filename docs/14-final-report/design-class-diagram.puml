  class ProductV1Controller
  class CategoryV1Controller
  class CartV1Controller
  class OrderV1Controller
  class LicenseV1Controller
  class AdminOrderV1Controller
}
package Control {
  interface IUserService
  interface IProductService
  interface ICategoryService
  interface ICartService
  interface IOrderService
  interface ILicenseService
  interface IPaymentService
}
package Mediator {
  class UserMediator
  class ProductMediator
  class CategoryMediator
  class CartMediator
  class CheckoutFacade
  class PaymentMediator
  class LicenseMediator
}
package Entity {
